# ==============================================================================
# Environment Configuration Template (.env.example)
# IMPORTANT: Copy this file to '.env' and set your local environment values.
# Do NOT commit real passwords or sensitive credentials to version control.
# ==============================================================================

# Application Base URLs
BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:9002

# ------------------------------------------------------------------------------
# Database Configuration (Common SQL Server defaults as generic examples)
# ------------------------------------------------------------------------------
# DB_SERVER: Database host address (e.g., localhost, 127.0.0.1, or db-container)
DB_SERVER=localhost
# DB_PORT: Standard SQL Server port is 1433 (or mapped port like 20000 in custom docker-compose)
DB_PORT=1433
# DB_NAME: Target database name
DB_NAME=YourDatabaseName
# DB_USER: Database login user (e.g., 'sa' for SQL Server admin, 'postgres' for PostgreSQL)
DB_USER=sa
# DB_PASSWORD: User password (Generic placeholder - Replace with your actual local secret in .env)
DB_PASSWORD=YourSecurePassword123!
# DB_ENCRYPT: Enable TLS encryption ('true' for production/cloud, 'false' for local containers)
DB_ENCRYPT=false
# DB_TRUST_SERVER_CERTIFICATE: Trust self-signed certificates in local environments
DB_TRUST_SERVER_CERTIFICATE=true

# ------------------------------------------------------------------------------
# Playwright Execution Settings
# ------------------------------------------------------------------------------
HEADLESS=true
SLOW_MO=0

# ------------------------------------------------------------------------------
# Centralized Logging Settings (Winston Logger)
# ------------------------------------------------------------------------------
# LOG_LEVEL: Defines the minimum severity level of logs printed to the console.
# Winston supports npm logging priority levels (from highest to lowest severity):
#   - 'error'   : Only logs critical runtime errors and request failures (status >= 400).
#   - 'warn'    : Logs errors and warnings.
#   - 'info'    : Standard logging (general test events, steps, HTTP endpoints, queries).
#   - 'http'    : Detailed HTTP logging information.
#   - 'verbose' : Verbose operational messages.
#   - 'debug'   : In-depth debugging traces and inspection.
#   - 'silly'   : Maximum possible verbosity (every single trace).
# Default recommended: 'info' for local development, 'warn' or 'error' for CI/CD pipelines.
LOG_LEVEL=info

# LOG_HTTP: Controls whether successful HTTP request/response payloads are printed to console.
#   - 'true'  : Prints full request payload, headers, response status and response body.
#   - 'false' : Suppresses success traffic logs (only errors >= 400 will be output).
LOG_HTTP=true
