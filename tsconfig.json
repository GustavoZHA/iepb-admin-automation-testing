{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@config/*": ["./config/*"],
      "@api/*": ["./src/api/*"],
      "@db/*": ["./src/db/*"],
      "@ui/*": ["./src/ui/*"],
      "@fixtures/*": ["./src/fixtures/*"]
    }
  },
  "include": [
    "playwright.config.ts",
    "config/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
