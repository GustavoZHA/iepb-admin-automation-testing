{
  "name": "iepb-admin-automation-testing",
  "version": "1.0.0",
  "description": "Integrated UI, API, and Database Test Automation Framework with Playwright and TypeScript for IEPB Admin",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --grep @ui",
    "test:api": "playwright test --grep @api",
    "test:backend": "playwright test --grep @backend",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "api-testing",
    "ui-testing",
    "sql-server"
  ],
  "author": "Gustavo",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.5",
    "@types/winston": "^2.4.4",
    "dotenv": "^18.0.8",
    "mssql": "^12.7.10",
    "typescript": "^7.0.2",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  }
}
